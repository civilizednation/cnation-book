# 이 파일을 .env 로 복사한 뒤 실제 키를 넣으세요. (.env 는 git 에 올라가지 않습니다)
# 키가 있는 AI 만 사용됩니다. 순서: Gemini -> GitHub Models (모두 무료 키)
# Gemini 키는 정리·교차 확인뿐 아니라 "AI 검색"(Google 검색 연동)에도 쓰이므로 꼭 넣는 것을 권장합니다.
GEMINI_API_KEY=
GITHUB_MODELS_TOKEN=
# 필수: 책 정보 웹 검색 (https://app.tavily.com)
TAVILY_API_KEY=

# 선택 설정
# AI_ORDER=gemini,github
# GEMINI_MODEL=gemini-flash-latest
# GITHUB_MODEL=openai/gpt-4.1-mini
